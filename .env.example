# The environment variables this repository reads. Nothing here loads a .env
# file: export them in the shell that runs the demo, as the README shows.
# With none set, everything runs on the deterministic offline mock.

# mock | anthropic. A name without its matching key falls back to the mock,
# so a stray AGENT_PROVIDER in a shell cannot turn a test run into live calls.
# AGENT_PROVIDER=mock

# Required only for AGENT_PROVIDER=anthropic. Never commit a real key.
# ANTHROPIC_API_KEY=sk-ant-...

# The model the Anthropic provider calls.
# AGENT_MODEL=claude-opus-4-8
